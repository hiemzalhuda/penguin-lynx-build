<?xml version="1.0" encoding="UTF-8"?>
<!-- penguin-17 local manifest: Pixel 7a / lynx -->
<!-- For Penguin OS. Used by repo sync in AOSPA source root with repo manifest. -->
<!-- Diadaptasi dari raj-tirtha/local_manifests cheetah.xml (penguin-17),
     buat Pixel 7 / 7 Pro, ke lynx. Perbedaan utama: device tree dan
     vendor lynx memakai LineageOS/TheMuppets stock lineage-24.0
     (belum ada fork lynx), kernel prebuilt LineageOS lynx-kernels. -->
<!-- Fetch source-first for all projects: use the canonical AOSPA remotes,
     this file only overrides (replaces / adds) additional projects. -->
<!-- Perbaikan 10 Nov 2026 (terverifikasi via git ls-remote / GitHub API):
     - HAPUS TheMuppets/proprietary_vendor_google: branch lineage-24.0
       TIDAK ADA (tertinggi lineage-19.1, repo perangkat lama). vendor/
       google/lynx sudah tercakup repo TheMuppets lynx di bawah.
     - HAPUS 21 entri google-modules/aosp/* @ android-17.0.0_r2: repo
       TIDAK ADA di android.googlesource.com (404, dua varian path
       dites). Tidak dibutuhkan: tree Infinity-X di server TIDAK punya
       kernel/google-modules sama sekali dan build 4.2 tetap jalan +
       boot — kernel lynx prebuilt (.ko sudah di lynx-kernels).
     - HAPUS TeamWin/android_external_v4afx: repo 404 di GitHub API,
       commit tidak bisa diverifikasi. V4A cuma efek audio, bukan
       kebutuhan boot; inherit-nya juga dihapus dari aospa_lynx.mk. -->
<manifest>
  <!-- Device tree + SoC Tensor G2 (LineageOS stock, lineage-24.0) -->
  <project name="LineageOS/android_device_google_lynx" path="device/google/lynx" remote="github" revision="lineage-24.0" />
  <project name="LineageOS/android_device_google_gs201" path="device/google/gs201" remote="github" revision="lineage-24.0" />

  <!-- Prebuilt kernels for lynx (6.1 Image.lz4, modules, dtbo) -->
  <project name="LineageOS/android_device_google_lynx-kernels" path="device/google/lynx-kernels" remote="github" revision="lineage-24.0" />

  <!-- Vendor blob lynx (TheMuppets, lineage-24.0) -->
  <project name="TheMuppets/proprietary_vendor_google_lynx" path="vendor/google/lynx" remote="github" revision="lineage-24.0" />

  <!-- hardware/google/pixel (LineageOS, lineage-24.0) — DITAMBAH 11 Nov 2026:
       build pertama gagal di lunch: device/google/gs201/common.mk:122
       butuh hardware/google/pixel/rebalance_interrupts/rebalance_interrupts.mk
       yang tidak ada di manifest PenguinOS/AOSP. hardware/google/av,
       camera, interfaces sudah ada dari manifest; yang hilang hanya pixel. -->
  <project name="LineageOS/android_hardware_google_pixel" path="hardware/google/pixel" remote="github" revision="lineage-24.0" />

  <!-- hardware/qcom/wlan: DIGANTI ke LineageOS (11 Nov 2026) —
       build #4 gagal di Soong bootstrap: vendor/google/lynx/Android.bp
       butuh soong_namespace hardware/qcom/wlan/wcn6740, tapi manifest
       AOSPA menyertakan AOSPA/android_hardware_qcom_wlan yang TIDAK
       punya subdir wcn6740 (isinya qcwcn/wcnss-service di top-level,
       buat HP QCOM). Tree LineageOS punya wcn6740/ (plus wcn7760 dan
       legacy) — itulah yang dipakai build Infinity-X lynx yang bekerja.
       Catatan: entri Lineage di bawah ini HARUS didahului remove-project,
       kalau tidak repo sync error "duplicate path hardware/qcom/wlan".
       Setelah mengganti remote, hapus dulu checkout lama
       (rm -rf hardware/qcom/wlan) baru repo sync ulang. -->
  <remove-project name="AOSPA/android_hardware_qcom_wlan" />
  <project name="LineageOS/android_hardware_qcom_wlan" path="hardware/qcom/wlan" remote="github" revision="lineage-24.0" />

  <!-- packages/resources/devicesettings: DIGANTI ke LineageOS (11 Nov 2026)
       — build #6 gagal di Soong: GoogleParts butuh modul
       org.lineageos.settings.resources, tapi manifest AOSPA menyertakan
       AOSPA/android_packages_resources_devicesettings yang mendefinisikan
       modul itu sebagai co.aospa.resources (tidak ada yang memakai nama
       itu di tree). Sama seperti wlan: remove-project dulu, hapus
       checkout lama (rm -rf packages/resources/devicesettings), baru
       repo sync ulang. -->
  <remove-project name="AOSPA/android_packages_resources_devicesettings" />
  <project name="LineageOS/android_packages_resources_devicesettings" path="packages/resources/devicesettings" remote="github" revision="lineage-24.0" />

  <!-- hardware/qcom-caf/common: TIDAK disync (11 Nov 2026) — build #8:
       repo ini mendefinisikan ~90 modul rfs_* symlink + mountpoint yang
       SUDAH ada di device/qcom/common/Android.bp (AOSPA) → Soong mati
       96x "module already defined". Satu-satunya modul dari repo ini
       yang dipakai tree adalah qti_kernel_headers, dan itu disediakan
       oleh shim lokal tree-files/hardware/qcom-caf/common/Android.bp
       (disalin ke tree oleh build script). Jangan tambah project ini
       ke manifest tanpa menghapus shim itu dulu. -->

  <!-- hardware/lineage/interfaces (LineageOS, lineage-24.0) — DITAMBAH
       11 Nov 2026: build #13 gagal di Soong: hardware/google/pixel/
       touch butuh modul vendor.lineage.touch-V1-ndk (AIDL interface
       vendor.lineage.touch) yang hanya ada di repo ini. Repo ini
       tidak ada di manifest AOSPA (hardware/lineage/ di tree Penguin
       hanya berisi compat). -->
  <project name="LineageOS/android_hardware_lineage_interfaces" path="hardware/lineage/interfaces" remote="github" revision="lineage-24.0" />

  <!-- hardware/google/interfaces: GANTI AOSP → LineageOS (11 Nov 2026).
       Build #15 gagal di Soong: vendor/google/lynx (TheMuppets)
       butuh com.google.hardware.pixel.display-V23-ndk, tapi AIDL
       interface itu di repo AOSP (platform/hardware/google/interfaces,
       pin commit clo-la) hanya sampai versi 21 — versi 22/23 adalah
       tambahan Lineage (repo Lineage sampai V23). Pola yang sama
       seperti wlan (#4) dan devicesettings (#6). -->
  <remove-project name="platform/hardware/google/interfaces" />
  <project name="LineageOS/android_hardware_google_interfaces" path="hardware/google/interfaces" remote="github" revision="lineage-24.0" />
</manifest>
