  <project name="LineageOS/android_device_google_lynx" path="device/google/lynx" remote="github" revision="lineage-24.0" />
  <project name="LineageOS/android_device_google_gs201" path="device/google/gs201" remote="github" revision="lineage-24.0" />

  <!-- Prebuilt kernels for lynx (6.1 Image.lz4, modules, dtbo) -->
